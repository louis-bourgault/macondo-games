# Build the Ferretboard "Go hosts MicroPython" firmware.
#
# Two targets:
#   just host   MICROPYTHON_ROOT=/path/to/micropython   # PC reference (gcc)
#   just device MICROPYTHON_ROOT=/path/to/micropython   # RP2040/RP2350 .uf2
#
# MICROPYTHON_ROOT defaults to ~/src/micropython and must point at a full
# MicroPython checkout (cloned, not vendored). The embed package is generated
# under $MICROPYTHON_ROOT/examples/embedding/micropython_embed.
#
# Architecture: Go's main() is the entry point (main.go). The MicroPython C
# sources are precompiled into a static archive (build/libmp_embed*.a) and
# linked in via generated cgo LDFLAGS (z_cgo_link_*.go). host.c is compiled by
# cgo as part of the Go build and bridges MP calls to the Go //export funcs.

MICROPYTHON_ROOT := env_var_or_default("MICROPYTHON_ROOT", env_var("HOME") + "/src/micropython")
EMBED_SRC := MICROPYTHON_ROOT + "/examples/embedding"
EMBED_DIR := EMBED_SRC + "/micropython_embed"
ROOT := justfile_directory()

# --- shared: generate the MP embed package + our cgo link flags --------------
# Extra MP sources the stock embed generator omits but the raw REPL needs:
#   pyexec.c:            the friendly/raw/paste REPL loop the editor speaks to
#   interrupt_char.c:    mp_hal_set_interrupt_char (Ctrl-C while executing)
#   readline/:           line editing used by the friendly REPL
# (No VFS/extmod sources: the filesystem is owned by Go, flash_fs.go.)
embed:
    cd {{EMBED_SRC}} && make -f micropython_embed.mk MICROPYTHON_TOP=../..
    cp {{ROOT}}/port/mpconfigport.h {{EMBED_DIR}}/port/mpconfigport.h
    cp {{ROOT}}/port/mphalport.c {{EMBED_DIR}}/port/mphalport.c
    cp {{ROOT}}/port/mphalport.h {{EMBED_DIR}}/port/mphalport.h
    cp {{ROOT}}/port/repl_stubs.c {{EMBED_DIR}}/port/repl_stubs.c
    # ABI header for the port C sources (mphalport.c, repl_stubs.c), which
    # are compiled both by cgo (from ROOT, where the header lives) and as part
    # of the embed package (where it must sit in port/ for -Iport).
    cp {{ROOT}}/ferret_abi.h {{EMBED_DIR}}/port/ferret_abi.h
    cp {{MICROPYTHON_ROOT}}/shared/runtime/pyexec.c {{EMBED_DIR}}/shared/runtime/pyexec.c
    cp {{MICROPYTHON_ROOT}}/shared/runtime/pyexec.h {{EMBED_DIR}}/shared/runtime/pyexec.h
    cp {{MICROPYTHON_ROOT}}/shared/runtime/interrupt_char.c {{EMBED_DIR}}/shared/runtime/interrupt_char.c
    cp {{MICROPYTHON_ROOT}}/shared/runtime/interrupt_char.h {{EMBED_DIR}}/shared/runtime/interrupt_char.h
    mkdir -p {{EMBED_DIR}}/shared/readline
    cp {{MICROPYTHON_ROOT}}/shared/readline/readline.c {{EMBED_DIR}}/shared/readline/readline.c
    cp {{MICROPYTHON_ROOT}}/shared/readline/readline.h {{EMBED_DIR}}/shared/readline/readline.h
    # The `time` module (sleep/ticks); enabled by MICROPY_PY_TIME in our
    # mpconfigport.h. extmod/*.c present here are picked up both by the genhdr
    # scan below (SRC_QSTR wildcard) and by the mp-*/device archive compile.
    cp {{MICROPYTHON_ROOT}}/extmod/modtime.c {{EMBED_DIR}}/extmod/modtime.c
    cp {{MICROPYTHON_ROOT}}/extmod/modtime.h {{EMBED_DIR}}/extmod/modtime.h
    # Drop sources from earlier builds that the Go-owned filesystem no longer
    # compiles (vfs, os, binascii, littlefs, flash_storage). This must run
    # BEFORE genhdr: the module-def scan reads every extmod/*.c present, and a
    # regenerated module def for a source we then delete would fail the link
    # with undefined mp_module_* symbols (see BUILDING.md §4).
    rm -f {{EMBED_DIR}}/extmod/vfs.c {{EMBED_DIR}}/extmod/vfs.h \
          {{EMBED_DIR}}/extmod/vfs_blockdev.c {{EMBED_DIR}}/extmod/modos.c \
          {{EMBED_DIR}}/extmod/misc.h {{EMBED_DIR}}/extmod/vfs_lfs.c \
          {{EMBED_DIR}}/extmod/vfs_lfs.h {{EMBED_DIR}}/extmod/vfs_lfsx.c \
          {{EMBED_DIR}}/extmod/vfs_lfsx_file.c {{EMBED_DIR}}/extmod/modbinascii.c \
          {{EMBED_DIR}}/lib/littlefs/lfs2.c {{EMBED_DIR}}/lib/littlefs/lfs2.h \
          {{EMBED_DIR}}/lib/littlefs/lfs2_util.c {{EMBED_DIR}}/lib/littlefs/lfs2_util.h \
          {{EMBED_DIR}}/shared/timeutils/timeutils.c {{EMBED_DIR}}/shared/timeutils/timeutils.h \
          {{EMBED_DIR}}/port/flash_storage.c
    # Regenerate genhdr so qstrs / root pointers / module defs cover the extra
    # sources above (pyexec, readline, modtime), which the bare generator's
    # py/-only scan would otherwise miss. Wipe the previous outputs first: the
    # make only re-collects when sources change, and the per-file .qstr scans
    # encode the OLD mpconfigport.h (e.g. array/io/os module defs).
    rm -rf {{EMBED_DIR}}/build-local {{EMBED_DIR}}/genhdr
    cp {{ROOT}}/port/embed-genhdr.mk {{EMBED_DIR}}/embed-genhdr.mk
    cd {{EMBED_DIR}} && make -f embed-genhdr.mk MICROPYTHON_TOP={{MICROPYTHON_ROOT}} genhdr
    mkdir -p {{EMBED_DIR}}/genhdr
    cp {{EMBED_DIR}}/build-local/genhdr/*.h {{EMBED_DIR}}/genhdr/
    sh {{ROOT}}/gen_cgo.sh {{MICROPYTHON_ROOT}}

# --- shared MP CFLAGS (host and device differ only in the compiler) ----------
MP_CFLAGS := "-I" + ROOT + " -I" + EMBED_DIR + " -I" + EMBED_DIR + "/port -I" + EMBED_DIR + "/.. -I" + EMBED_DIR + "/../.."

# --- compile all MP embed C sources into a static archive --------------------
# TARGET decides the CPU flags; defaults to the Ferretboard (RP2040 with a
# 16 MiB flash chip: __flash_size=16M in ferretboard.json). The 8 MiB
# LittleFS region needs the 16 MiB target; the stock "pico" (2 MiB) target
# would make the region math go negative and panic at boot.
TARGET := "ferretboard.json"
ARM_MCPU := if TARGET == "ferretboard2.json" { "cortex-m33" } else { "cortex-m0plus" }
ARM_BOARD_DEFINE := if TARGET == "ferretboard2.json" { "-DFERRETBOARD_RP2350=1" } else { "-DFERRETBOARD_RP2040=1" }

mp-arm: embed
    mkdir -p {{ROOT}}/build/arm
    rm -f {{ROOT}}/build/arm/*.o
    find {{EMBED_DIR}} -name '*.c' | sort | while read src; do \
        obj={{ROOT}}/build/arm/$(basename "$src" .c).o; \
        arm-none-eabi-gcc {{MP_CFLAGS}} {{ARM_BOARD_DEFINE}} -mcpu={{ARM_MCPU}} -mthumb -Wall -O2 -fno-common -c "$src" -o "$obj"; \
    done
    arm-none-eabi-ar rcs {{ROOT}}/build/libmp_embed.a {{ROOT}}/build/arm/*.o
    # re-fingerprint with the fresh archive (embed already ran gen_cgo.sh
    # before the archive was rebuilt, so its md5 was one build behind)
    sh {{ROOT}}/gen_cgo.sh {{MICROPYTHON_ROOT}}

mp-host: embed
    mkdir -p {{ROOT}}/build/host
    rm -f {{ROOT}}/build/host/*.o
    find {{EMBED_DIR}} -name '*.c' | sort | while read src; do \
        obj={{ROOT}}/build/host/$(basename "$src" .c).o; \
        gcc {{MP_CFLAGS}} -Wall -Og -fno-common -c "$src" -o "$obj"; \
    done
    ar rcs {{ROOT}}/build/libmp_embed_host.a {{ROOT}}/build/host/*.o
    sh {{ROOT}}/gen_cgo.sh {{MICROPYTHON_ROOT}}

# === DEVICE (RP2040 / RP2350) ================================================
# tinygo builds the whole firmware (Go engine + MP archive + host.c) and
# packages it as a UF2. Flash with: picotool load ferret.uf2 -f
device: mp-arm
    cd {{ROOT}} && tinygo build -target {{TARGET}} -size short -o ferret.uf2 .
    @echo "Built {{ROOT}}/ferret.uf2 - flash with: picotool load {{ROOT}}/ferret.uf2 -f"

# === HOST (PC reference) =====================================================
# An interactive MP REPL over stdin/stdout; drawing goes to a no-op stub.
host: mp-host
    cd {{ROOT}} && go build -o spike .
    @echo "Built {{ROOT}}/spike - run it and type MicroPython (ferret.* calls the Go engine)"

# === cleanup ================================================================
clean:
    rm -rf {{ROOT}}/build {{ROOT}}/spike {{ROOT}}/ferret.uf2
    rm -f {{ROOT}}/z_cgo_link_host.go {{ROOT}}/z_cgo_link_tinygo.go
